{
  "mcpServers": {
    "starboard": {
      "command": "starboard-mcp",
      "args": ["--transport", "stdio"],
      "timeout": 900,
      "env": {
        "DATABRICKS_HOST": "${DATABRICKS_HOST}",
        "LLM_PROVIDER": "${LLM_PROVIDER}",
        "LLM_API_KEY": "${LLM_API_KEY}",
        "LLM_MODEL": "${LLM_MODEL}"
      }
    }
  }
}
